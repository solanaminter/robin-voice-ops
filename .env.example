# Copy to .env for local development. NEVER commit a real key.
# Production: set these as environment variables (Vercel dashboard / host).

# AssemblyAI API key (server-side only — the browser uses short-lived temp tokens).
ASSEMBLYAI_API_KEY=

# Postgres connection string for persistent storage (e.g. Neon). If unset,
# the app falls back to ROBIN_DB_PATH (SQLite) or in-memory demo mode.
DATABASE_URL=

# Local SQLite path for the self-hosted server / local dev.
ROBIN_DB_PATH=./data/robin.db

# Twilio (for the PSTN bridge in server/ — all optional until you attach a number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
